# scripts/GenerateVersion.cmake
# Generates GitVersion.h if Git commit hash changed.
# Expects SOURCE_DIR and BINARY_DIR to be passed via -D (defaults to CMAKE_CURRENT_*_DIR).

if(NOT DEFINED SOURCE_DIR)
    set(SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
endif()
if(NOT DEFINED BINARY_DIR)
    set(BINARY_DIR "${CMAKE_CURRENT_BINARY_DIR}")
endif()

find_package(Git QUIET)
if(GIT_FOUND)
    execute_process(
        COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD
        WORKING_DIRECTORY "${SOURCE_DIR}"
        OUTPUT_VARIABLE GIT_DESCRIBE_OUTPUT
        OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET
    )
endif()

if(NOT GIT_DESCRIBE_OUTPUT)
    set(GIT_DESCRIBE_OUTPUT "unknown")
endif()

set(VERSION_CONTENT "// Auto-generated by CMake build\n#define APP_VERSION \"${GIT_DESCRIBE_OUTPUT}\"\n")

if(EXISTS "${BINARY_DIR}/GitVersion.h")
    file(READ "${BINARY_DIR}/GitVersion.h" OLD_CONTENT)
else()
    set(OLD_CONTENT "")
endif()

if(NOT "${VERSION_CONTENT}" STREQUAL "${OLD_CONTENT}")
    file(WRITE "${BINARY_DIR}/GitVersion.h" "${VERSION_CONTENT}")
endif()
